# ═══════════════════════════════════════════════════════════════════════════
# Trigger.dev Task Package — Environment Variables
#
# Copy to packages/trigger/.env and fill in values before running:
#   npx trigger deploy
# ═══════════════════════════════════════════════════════════════════════════

# ── Trigger.dev ─────────────────────────────────────────────────────────────
# https://cloud.trigger.dev → Your Project → Settings → API Keys
TRIGGER_SECRET_KEY=tr_dev_
TRIGGER_PROJECT_ID=proj_

# ── Database (same as web app) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ── Encryption (MUST match web app ENCRYPTION_KEY exactly) ───────────────
ENCRYPTION_KEY=

# ── AI Services ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-
ANTHROPIC_API_KEY=sk-ant-api03-
ELEVENLABS_API_KEY=

# ── Google OAuth (for token refresh task) ────────────────────────────────
GOOGLE_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-

# ── Storage ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (for notifications) ────────────────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM=TubeForge <noreply@yourdomain.com>

# ── Video Generation ────────────────────────────────────────────────────
# Free stock footage (default provider) — https://www.pexels.com/api/
PEXELS_API_KEY=
# Optional paid alternatives — original AI-generated video per scene
RUNWAY_API_KEY=
PIKA_API_KEY=
