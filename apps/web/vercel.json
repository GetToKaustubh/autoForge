{
  "regions": ["bom1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web",
  "outputDirectory": ".next",
  "functions": {
    "app/api/production/**": { "maxDuration": 300 },
    "app/api/publishing/**": { "maxDuration": 300 },
    "app/api/research/**":   { "maxDuration": 60  },
    "app/api/content/**":    { "maxDuration": 60  },
    "app/api/**":            { "maxDuration": 30  }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
