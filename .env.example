# ═══════════════════════════════════════════════════════════════════════════
# TubeForge — Environment Variables
#
# HOW TO USE:
#   Local dev  →  copy this file to apps/web/.env.local and fill in values
#   Vercel     →  run the CLI commands listed in each section below
#
# NEVER commit .env.local or any file with real secrets to git
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# PHASE 1 — REQUIRED TO BOOT (app crashes without these)
# ───────────────────────────────────────────────────────────────────────────

# ── Clerk (Authentication) ──────────────────────────────────────────────────
# Sign up at https://clerk.com → Create application → API Keys
# Vercel CLI:
#   vercel env add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   vercel env add CLERK_SECRET_KEY
#   vercel env add CLERK_WEBHOOK_SECRET
#
# Webhook setup: Clerk Dashboard → Webhooks → Add Endpoint
#   URL: https://your-app.vercel.app/api/webhooks/clerk
#   Events: user.created, user.updated, organization.created, organizationMembership.created
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Supabase (Database) ─────────────────────────────────────────────────────
# Sign up at https://supabase.com → New project → Settings → Database
#
# IMPORTANT: Use the connection POOLER URL (port 6543, mode=transaction) for DATABASE_URL
# This is under: Project Settings → Database → Connection Pooling
#
# Vercel CLI:
#   vercel env add DATABASE_URL
#   vercel env add SUPABASE_URL
#   vercel env add SUPABASE_ANON_KEY
#   vercel env add SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Encryption Key ─────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt YouTube OAuth tokens before storing in DB
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Never change this after connecting YouTube channels — tokens will become unreadable
# Vercel CLI:
#   vercel env add ENCRYPTION_KEY
ENCRYPTION_KEY=

# ── Upstash Redis (Cache + Rate Limiting) ──────────────────────────────────
# Sign up at https://console.upstash.com → Create Database → REST API tab
# Choose region: ap-south-1 (Mumbai) for lowest latency
# Vercel CLI:
#   vercel env add UPSTASH_REDIS_REST_URL
#   vercel env add UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Application URL ────────────────────────────────────────────────────────
# Vercel CLI:
#   vercel env add NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

NODE_ENV=production
LOG_LEVEL=info


# ───────────────────────────────────────────────────────────────────────────
# PHASE 2 — REQUIRED FOR FEATURES (add before testing each feature)
# ───────────────────────────────────────────────────────────────────────────

# ── Google / YouTube OAuth ─────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable these APIs:
#    - YouTube Data API v3
#    - YouTube Analytics API
#    - YouTube Reporting API
# 3. OAuth 2.0 → Create credentials → Web application
#    Authorized redirect URI: https://your-app.vercel.app/api/auth/youtube/callback
# Vercel CLI:
#   vercel env add GOOGLE_CLIENT_ID
#   vercel env add GOOGLE_CLIENT_SECRET
#   vercel env add GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/youtube/callback

# ── OpenAI ─────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# Used for: idea generation, keyword research, thumbnail generation (DALL-E 3)
# Vercel CLI:  vercel env add OPENAI_API_KEY
OPENAI_API_KEY=sk-proj-

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# https://console.anthropic.com/account/keys
# Used for: niche research, script generation, SEO optimization
# Vercel CLI:  vercel env add ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-api03-

# ── Trigger.dev (Background Jobs) ──────────────────────────────────────────
# https://cloud.trigger.dev → Create project → Settings → API Keys
# After adding keys, deploy tasks: cd packages/trigger && npx trigger deploy
# Vercel CLI:
#   vercel env add TRIGGER_SECRET_KEY
#   vercel env add TRIGGER_PROJECT_ID
TRIGGER_SECRET_KEY=tr_dev_
TRIGGER_PROJECT_ID=proj_

# ── Resend (Email) ─────────────────────────────────────────────────────────
# https://resend.com/api-keys
# Add your sending domain in Resend → Domains
# Vercel CLI:
#   vercel env add RESEND_API_KEY
#   vercel env add EMAIL_FROM
RESEND_API_KEY=re_
EMAIL_FROM=TubeForge <noreply@yourdomain.com>

# ── Cloudinary (Video/Image Storage) ───────────────────────────────────────
# https://cloudinary.com/console → Account details
# Vercel CLI:
#   vercel env add CLOUDINARY_CLOUD_NAME
#   vercel env add CLOUDINARY_API_KEY
#   vercel env add CLOUDINARY_API_SECRET
#   vercel env add NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── ElevenLabs (Voice Generation) ──────────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
# Vercel CLI:  vercel env add ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=


# ───────────────────────────────────────────────────────────────────────────
# PHASE 3 — OPTIONAL (add when you need these features)
# ───────────────────────────────────────────────────────────────────────────

# ── Runway ML (AI Video Generation — premium) ──────────────────────────────
# https://app.runwayml.com/account → API
# Only needed for Runway Gen-3 video generation (Pika is the default)
RUNWAY_API_KEY=

# ── Pika (AI Video Generation — default) ───────────────────────────────────
PIKA_API_KEY=

# ── Sentry (Error Monitoring) ──────────────────────────────────────────────
# https://sentry.io → Create project (Next.js)
# Vercel CLI:
#   vercel env add SENTRY_DSN
#   vercel env add NEXT_PUBLIC_SENTRY_DSN
#   vercel env add SENTRY_AUTH_TOKEN
#   vercel env add SENTRY_ORG
#   vercel env add SENTRY_PROJECT
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=youtube-automation

# ── Stripe (Billing) ───────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Webhook: https://your-app.vercel.app/api/billing/webhook
# Vercel CLI:
#   vercel env add STRIPE_PUBLISHABLE_KEY
#   vercel env add STRIPE_SECRET_KEY
#   vercel env add STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
